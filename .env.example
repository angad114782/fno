# ============ REQUIRED ============
# MongoDB connection string (local ya MongoDB Atlas)
# Local:  mongodb://127.0.0.1:27017/fno_reporter
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fno_reporter?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fno_reporter

# Server port
PORT=5000

# ============ SECURITY (recommended) ============
# Set karoge to har /api request pe header "x-api-key" chahiye hoga (dashboard pe ek baar puchega)
API_KEY=change-this-to-a-long-random-string

# TradingView / external alerts ke liye secret (webhook body me "secret" field)
WEBHOOK_SECRET=change-this-webhook-secret

# ============ TRADE RULES ============
# TP1 hit hone par kitna % quantity book karni hai (lot multiple me round-down hota hai)
TP1_EXIT_PERCENT=50
# TP1 hit hone ke baad SL ko entry (cost) pe shift karna hai?
MOVE_SL_TO_COST_ON_TP1=true
# Brokerage per executed order (entry + har exit). Upstox = 30 (brokerage API se check kiya), Zerodha/Angel = 20
BROKERAGE_PER_ORDER=20

# ============ WHATSAPP ALERTS (Cloud API, optional) ============
# Meta developer app -> WhatsApp -> API Setup: phone number id + permanent (system user) token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Kis number pe alert (country code ke saath, jaise 919876543210). Comma se kai numbers
WHATSAPP_TO=
# Approved template ka naam / language / body me kitne {{n}} params. Har alert line ek param me jaati hai
WHATSAPP_TEMPLATE=lead_notification
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_PARAMS=5
# Roz is time (IST, HH:MM) pe din ki P&L report WhatsApp pe (Mon-Fri). Khali = off
DAILY_REPORT_TIME=15:45

# Reports ka timezone
REPORT_TIMEZONE=Asia/Kolkata

# ============ UPSTOX (live data + analysis + backtest) ============
# https://account.upstox.com/developer/apps -> New App banao
# Redirect URL wahan EXACTLY ye daalo: http://localhost:5000/auth/upstox/callback
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Default: http://localhost:<PORT>/auth/upstox/callback
UPSTOX_REDIRECT_URI=
# Optional: Upstox "Analytics Token" (lambi validity, sirf market data). Isse roz login nahi karna padta.
# Ye set hai to live LTP/analysis/backtest isi se chalega.
UPSTOX_ACCESS_TOKEN=

# ============ SIGNALS / RISK ============
# Capital protection defaults (dashboard pe "Rules badlo" se bhi badal sakte ho)
CAPITAL=30000
# Ek trade me capital ka max % loss (lots isi se)
RISK_PCT=1.5
MAX_TRADES_PER_DAY=2
DAILY_LOSS_PCT=3
MONTHLY_LOSS_PCT=10
# Expiry day pe us din expire hone wale option ki jagah next expiry
NO_EXPIRY_DAY=true
# Market hours me in symbols ko har candle pe scan karke naya signal WhatsApp pe bhejega
WATCHLIST=NIFTY,BANKNIFTY
SIGNAL_INTERVAL_MIN=3
# Live scan strategy: scalp (3 min momentum + time stop) | orb | trend | pdhl | vwaprev
SIGNAL_STRATEGY=scalp
SIGNAL_ALERTS=true
# Open trades ka live LTP har kitne second me (0 = off)
LIVE_POLL_SECONDS=5
