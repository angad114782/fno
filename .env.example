# ============ REQUIRED ============
# MongoDB connection string (local ya MongoDB Atlas)
# Local:  mongodb://127.0.0.1:27017/fno_reporter
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fno_reporter?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fno_reporter

# Server port
PORT=5000

# ============ SECURITY (recommended) ============
# Set karoge to har /api request pe header "x-api-key" chahiye hoga (dashboard pe ek baar puchega)
API_KEY=change-this-to-a-long-random-string

# TradingView / external alerts ke liye secret (webhook body me "secret" field)
WEBHOOK_SECRET=change-this-webhook-secret

# ============ TRADE RULES ============
# TP1 hit hone par kitna % quantity book karni hai (lot multiple me round-down hota hai)
TP1_EXIT_PERCENT=50
# TP1 hit hone ke baad SL ko entry (cost) pe shift karna hai?
MOVE_SL_TO_COST_ON_TP1=true
# Brokerage per executed order (entry + har exit). Zerodha/Angel etc = 20
BROKERAGE_PER_ORDER=20

# ============ TELEGRAM ALERTS (optional) ============
# @BotFather se bot banao -> token. Chat ID ke liye bot ko message karke
# https://api.telegram.org/bot<TOKEN>/getUpdates kholo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Roz is time (IST, HH:MM) pe din ki P&L report Telegram pe (Mon-Fri). Khali = off
DAILY_REPORT_TIME=15:45

# Reports ka timezone
REPORT_TIMEZONE=Asia/Kolkata
